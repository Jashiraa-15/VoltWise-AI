# Backend Environment Variables (Render)
# Set FRONTEND_URL to your deployed Vercel frontend URL (e.g. https://voltwise-ai.vercel.app)
FRONTEND_URL=https://voltwise-ai.vercel.app
PORT=8000

# Frontend Environment Variables (Vercel)
# Set VITE_API_BASE_URL to your deployed Render backend URL (e.g. https://voltwise-ai.onrender.com)
VITE_API_BASE_URL=https://voltwise-ai.onrender.com
